# ---- Copy to .env and fill in. NEVER commit .env ----

# Database. Local default is SQLite in ./data (persists across restarts).
# Production: use a managed PostgreSQL URL (postgresql://user:pass@host:5432/dbname)
DATABASE_URL=sqlite:///./data/patients.db

# Load two clearly-labelled SYNTHETIC demo patients on startup (true/false)
SEED_DEMO_DATA=false

# Optional: if set, every /patients request must send header  X-API-Key: <value>
# Leave empty to keep the REST API open (fine for a short assessment demo).
API_KEY=

# Shared secret that Vapi sends with webhooks (see README step "Server URL secret").
# Strongly recommended for the deployed service.
VAPI_SERVER_SECRET=replace-with-a-long-random-string

# Public URL of the deployed API (used only by the config printer script)
PUBLIC_BASE_URL=https://your-api.example.com

# Logging level: DEBUG, INFO, WARNING
LOG_LEVEL=INFO

# ---- Dashboard only (set in the dashboard's environment / Streamlit secrets) ----
API_BASE_URL=http://localhost:8000
DASHBOARD_API_KEY=
